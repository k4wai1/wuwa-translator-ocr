{
  "name": "wuwa-translator-ocr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Client-side OCR translator for the Solaris-3 Script alphabet from Wuthering Waves",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "ml:dataset": "python3 scripts/generate_dataset.py",
    "ml:micro": "python3 scripts/generate_dataset.py --profile micro --out training/micro --train 1800 --val 250",
    "ml:train": "python3 scripts/train_chargen.py --epochs 30 --imgsz 192 --batch 16",
    "ml:export": "python3 scripts/export_chargen.py",
    "i18n:check": "node scripts/check_i18n.mjs",
    "prebuild": "pnpm i18n:check"
  },
  "dependencies": {
    "onnxruntime-web": "^1.23.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.16.1"
}
